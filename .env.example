# Copy to .env and adjust. Placeholders only: never commit real credentials.

# --- API service -------------------------------------------------------------
# Local development database (matches docker-compose.yml). Use a secret manager in shared environments.
DATABASE_URL=postgresql+psycopg://workspace:change-me@localhost:5432/workspace
APP_ENV=development
# "dev" trusts X-Dev-Tenant / X-Dev-User headers and is refused when APP_ENV=production.
AUTH_MODE=dev
# Only needed when the web app is served from a different origin than the API.
CORS_ORIGINS=
MAX_BODY_BYTES=1048576
LOG_LEVEL=INFO

# --- Model providers (Milestone 2; not used yet) — see docs/adr/0007-model-providers.md
# MODEL_PROFILE=hf-router            # hf-router | self-hosted | ollama
# MODEL_BASE_URL=https://router.huggingface.co/v1
# MODEL_ID=Qwen/<model-repo>
# HF_TOKEN=                          # secret: server-side only, never sent to the browser
# Local alternative:
# MODEL_PROFILE=ollama
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_ID=gpt-oss:20b

# --- Workspace web (Vite) ----------------------------------------------------
# Leave empty to use the Vite dev proxy (same origin, no CORS needed).
VITE_API_BASE_URL=
VITE_DEV_TENANT=demo
VITE_DEV_USER=demo-user
