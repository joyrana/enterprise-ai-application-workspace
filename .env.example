# Copy to .env and adjust. Placeholders only: never commit real credentials.

# --- API service -------------------------------------------------------------
# Local development database (matches docker-compose.yml). Use a secret manager in shared environments.
DATABASE_URL=postgresql+psycopg://workspace:change-me@localhost:5432/workspace
APP_ENV=development
# "dev" trusts X-Dev-Tenant / X-Dev-User headers and is refused when APP_ENV=production.
AUTH_MODE=dev
# Only needed when the web app is served from a different origin than the API.
CORS_ORIGINS=
MAX_BODY_BYTES=1048576
LOG_LEVEL=INFO

# --- AI model (see docs/adr/0007-model-providers.md) ----------------------
# Leave MODEL_PROFILE empty to run without AI (discovery shows "not configured").
#
# Local gpt-oss on Ollama (prompts stay on your machine):
#   ollama pull gpt-oss:20b
# MODEL_PROFILE=ollama
# MODEL_ID=gpt-oss:20b
#
# Qwen through Hugging Face Inference Providers (prompts go to a third-party provider):
# MODEL_PROFILE=hf-router
# MODEL_ID=Qwen/<model-repo>          # pin an exact repository; optional :provider suffix
# HF_TOKEN=                           # secret: server-side only, never sent to the browser
#
# Self-hosted Qwen weights behind vLLM or TGI:
# MODEL_PROFILE=self-hosted
# MODEL_BASE_URL=http://gpu-host:8000/v1
# MODEL_ID=<served-model-name>
# MODEL_REMOTE=false                  # true if the endpoint is outside your network (then https is required)
#
# Optional tuning:
# MODEL_STRUCTURED_MODE=prompt_and_validate   # json_schema | json_object | prompt_and_validate
# MODEL_TIMEOUT_SECONDS=60
# MODEL_MAX_RETRIES=2
# MODEL_MAX_OUTPUT_TOKENS=2048
# MODEL_TEMPERATURE=0
# MODEL_SEED=
# MODEL_PRICE_INPUT_PER_MTOK=          # only from the provider's published prices
# MODEL_PRICE_OUTPUT_PER_MTOK=
# ALLOW_REMOTE_MODELS_FOR_CONFIDENTIAL=false
MODEL_PROFILE=

# --- Workspace web (Vite) ----------------------------------------------------
# Leave empty to use the Vite dev proxy (same origin, no CORS needed).
VITE_API_BASE_URL=
VITE_DEV_TENANT=demo
VITE_DEV_USER=demo-user
