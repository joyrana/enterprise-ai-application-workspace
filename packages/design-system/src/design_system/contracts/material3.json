{
  "contract_version": "1",
  "id": "material3",
  "name": "Material 3 (Angular)",
  "version": "1.0.0",
  "framework": "angular",
  "library": {
    "package": "@angular/material",
    "version": "22.2.2",
    "docs_url": "https://material.angular.dev/"
  },
  "mappings": {
    "heading:1": {
      "components": [
        "h1"
      ],
      "package": "html",
      "notes": "Page title; styled with the M3 headline-small type role."
    },
    "heading:2": {
      "components": [
        "h2"
      ],
      "package": "html",
      "notes": "M3 title-large type role."
    },
    "heading:3": {
      "components": [
        "h3"
      ],
      "package": "html",
      "notes": "M3 title-medium type role."
    },
    "heading:4": {
      "components": [
        "h4"
      ],
      "package": "html",
      "notes": "M3 title-small type role."
    },
    "text:default": {
      "components": [
        "p"
      ],
      "package": "html",
      "notes": "M3 body-medium type role."
    },
    "text:subtle": {
      "components": [
        "p"
      ],
      "package": "html",
      "notes": "M3 body-small type role in the on-surface-variant colour."
    },
    "section": {
      "components": [
        "section"
      ],
      "package": "html",
      "notes": "A labelled region (aria-label = section title)."
    },
    "form": {
      "components": [
        "form"
      ],
      "package": "html",
      "notes": "Reactive form (FormGroup) with native constraint attributes for accessibility."
    },
    "field:text": {
      "components": [
        "mat-form-field",
        "mat-label",
        "input[matInput]",
        "mat-hint",
        "mat-error"
      ],
      "package": "@angular/material",
      "notes": "Outline appearance; mat-error shows the validation message."
    },
    "field:textarea": {
      "components": [
        "mat-form-field",
        "mat-label",
        "textarea[matInput]",
        "mat-hint",
        "mat-error"
      ],
      "package": "@angular/material"
    },
    "field:number": {
      "components": [
        "mat-form-field",
        "mat-label",
        "input[matInput]",
        "mat-hint",
        "mat-error"
      ],
      "package": "@angular/material",
      "notes": "input type=number."
    },
    "field:date": {
      "components": [
        "mat-form-field",
        "mat-label",
        "input[matInput]",
        "mat-hint",
        "mat-error"
      ],
      "package": "@angular/material",
      "notes": "input type=date. The Material datepicker needs a date adapter and is not used yet."
    },
    "field:datetime": {
      "components": [
        "mat-form-field",
        "mat-label",
        "input[matInput]",
        "mat-hint",
        "mat-error"
      ],
      "package": "@angular/material",
      "notes": "input type=datetime-local."
    },
    "field:select": {
      "components": [
        "mat-form-field",
        "mat-label",
        "select[matNativeControl]",
        "option",
        "mat-error"
      ],
      "package": "@angular/material",
      "notes": "Native select inside the form field: fully accessible and keyboard-friendly; mat-select is not used yet."
    },
    "field:checkbox": {
      "components": [
        "mat-checkbox"
      ],
      "package": "@angular/material"
    },
    "field:file": {
      "components": [
        "label",
        "input"
      ],
      "package": "html",
      "notes": "Angular Material has no file input; a labelled native input is used."
    },
    "action:primary": {
      "components": [
        "button[mat-flat-button]"
      ],
      "package": "@angular/material",
      "notes": "Filled button; at most one per form."
    },
    "action:secondary": {
      "components": [
        "button[mat-stroked-button]"
      ],
      "package": "@angular/material",
      "notes": "Outlined button."
    },
    "action:danger": {
      "components": [
        "button[mat-flat-button]"
      ],
      "package": "@angular/material",
      "notes": "Filled button with the error colour role (class 'danger')."
    },
    "table": {
      "components": [
        "table[mat-table]",
        "th[mat-header-cell]",
        "td[mat-cell]",
        "tr[mat-header-row]",
        "tr[mat-row]",
        "tr[matNoDataRow]"
      ],
      "package": "@angular/material",
      "notes": "mat-table bound to the entity's records, with an empty-state row."
    },
    "stat": {
      "components": [
        "div",
        "p"
      ],
      "package": "html",
      "notes": "A labelled group with the value in the M3 headline-small role."
    },
    "message": {
      "components": [
        "div",
        "strong"
      ],
      "package": "html",
      "notes": "role=status; colours from the M3 container roles. Material has no banner component."
    },
    "toolbar": {
      "components": [
        "div",
        "button[mat-flat-button]",
        "button[mat-stroked-button]"
      ],
      "package": "@angular/material",
      "notes": "div role=toolbar; filled button for the primary action, outlined for the others."
    }
  },
  "unsupported": {},
  "tokens": {
    "color.background.default": "--mat-sys-surface",
    "color.background.subtle": "--mat-sys-surface-container",
    "color.background.brand": "--mat-sys-primary",
    "color.foreground.default": "--mat-sys-on-surface",
    "color.foreground.secondary": "--mat-sys-on-surface-variant",
    "color.foreground.subtle": "--mat-sys-on-surface-variant",
    "color.foreground.brand": "--mat-sys-primary",
    "color.foreground.danger": "--mat-sys-error",
    "color.border.default": "--mat-sys-outline-variant",
    "type.page-title": "--mat-sys-headline-small",
    "type.body": "--mat-sys-body-medium",
    "radius.default": "--mat-sys-corner-medium"
  },
  "rules": [
    "Colours, type and shape come from the Material 3 system variables (--mat-sys-*); generated styles never hard-code them except as fallbacks.",
    "Every control sits in mat-form-field with a mat-label (or is a labelled checkbox), so labels are programmatically associated.",
    "At most one filled (primary) button per form.",
    "Page titles are level-1 headings; heading levels are not skipped.",
    "Tables are labelled (aria-label from the caption) and show an empty-state row."
  ]
}
