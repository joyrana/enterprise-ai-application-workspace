{
  "contract_version": "1",
  "id": "fluent2",
  "name": "Fluent 2 (React)",
  "version": "1.0.0",
  "framework": "react",
  "library": {
    "package": "@fluentui/react-components",
    "version": "9.74.9",
    "docs_url": "https://react.fluentui.dev/"
  },
  "mappings": {
    "heading:1": {"components": ["Title2"], "package": "@fluentui/react-components", "notes": "Rendered as <h1>. Title2 keeps page titles proportionate inside an app shell."},
    "heading:2": {"components": ["Subtitle1"], "package": "@fluentui/react-components", "notes": "Rendered as <h2>."},
    "heading:3": {"components": ["Subtitle2"], "package": "@fluentui/react-components", "notes": "Rendered as <h3>."},
    "heading:4": {"components": ["Body1Strong"], "package": "@fluentui/react-components", "notes": "Rendered as <h4>."},
    "text:default": {"components": ["Body1"], "package": "@fluentui/react-components", "notes": "Rendered as <p>."},
    "text:subtle": {"components": ["Caption1"], "package": "@fluentui/react-components", "notes": "Rendered as <p>."},
    "section": {"components": ["section"], "package": "html", "notes": "A labelled region (aria-label = section title)."},
    "form": {"components": ["form"], "package": "html", "notes": "Labelled with aria-label; fields stacked, actions in one row after the fields."},
    "field:text": {"components": ["Field", "Input"], "package": "@fluentui/react-components", "notes": "Field supplies the label, required marker, hint and validation message."},
    "field:textarea": {"components": ["Field", "Textarea"], "package": "@fluentui/react-components"},
    "field:number": {"components": ["Field", "Input"], "package": "@fluentui/react-components", "notes": "Input type=number."},
    "field:date": {"components": ["Field", "Input"], "package": "@fluentui/react-components", "notes": "Input type=date. The Fluent DatePicker lives in a separate package (@fluentui/react-datepicker-compat) and is not used yet."},
    "field:datetime": {"components": ["Field", "Input"], "package": "@fluentui/react-components", "notes": "Input type=datetime-local."},
    "field:select": {"components": ["Field", "Select", "option"], "package": "@fluentui/react-components", "notes": "Native-backed Select for accessibility on all platforms; Dropdown/Combobox are for richer cases."},
    "field:checkbox": {"components": ["Checkbox"], "package": "@fluentui/react-components", "notes": "Checkbox carries its own label."},
    "field:file": {"components": ["Field", "input"], "package": "html", "notes": "Fluent 2 (v9) has no file-input component; a native input type=file inside Field keeps the label association."},
    "action:primary": {"components": ["Button"], "package": "@fluentui/react-components", "notes": "appearance=primary; at most one per form."},
    "action:secondary": {"components": ["Button"], "package": "@fluentui/react-components", "notes": "appearance=secondary."},
    "action:danger": {"components": ["Button"], "package": "@fluentui/react-components", "notes": "Fluent 2 has no destructive button appearance: appearance=secondary; generated code must confirm destructive actions in a dialog (Milestone 4)."},
    "table": {"components": ["Table", "TableHeader", "TableRow", "TableHeaderCell", "TableBody", "TableCell"], "package": "@fluentui/react-components", "notes": "aria-label = caption; an empty-state row when there is no data."},
    "stat": {"components": ["Card", "Caption1", "Title3"], "package": "@fluentui/react-components", "notes": "Label above value."},
    "message": {"components": ["MessageBar", "MessageBarBody", "MessageBarTitle"], "package": "@fluentui/react-components", "notes": "intent = info | warning | error | success."},
    "toolbar": {"components": ["Toolbar", "ToolbarButton"], "package": "@fluentui/react-components", "notes": "aria-label = toolbar label."}
  },
  "unsupported": {},
  "tokens": {
    "color.background.default": "colorNeutralBackground1",
    "color.background.subtle": "colorNeutralBackground2",
    "color.background.brand": "colorBrandBackground",
    "color.foreground.default": "colorNeutralForeground1",
    "color.foreground.secondary": "colorNeutralForeground2",
    "color.foreground.subtle": "colorNeutralForeground3",
    "color.foreground.brand": "colorBrandForeground1",
    "color.foreground.danger": "colorStatusDangerForeground1",
    "color.foreground.warning": "colorStatusWarningForeground1",
    "color.foreground.success": "colorStatusSuccessForeground1",
    "color.border.default": "colorNeutralStroke1",
    "color.border.subtle": "colorNeutralStroke2",
    "space.horizontal.s": "spacingHorizontalS",
    "space.horizontal.m": "spacingHorizontalM",
    "space.horizontal.l": "spacingHorizontalL",
    "space.vertical.s": "spacingVerticalS",
    "space.vertical.m": "spacingVerticalM",
    "space.vertical.l": "spacingVerticalL",
    "radius.medium": "borderRadiusMedium",
    "radius.large": "borderRadiusLarge",
    "stroke.thin": "strokeWidthThin",
    "font.family.base": "fontFamilyBase",
    "font.size.body": "fontSizeBase300",
    "font.size.subtitle": "fontSizeBase400",
    "font.weight.semibold": "fontWeightSemibold",
    "shadow.card": "shadow4"
  },
  "rules": [
    "Colors, spacing, radii and type come from tokens; generated code never hard-codes them.",
    "Every input is wrapped in Field (or carries its own label) so its label is programmatically associated.",
    "At most one primary button per form.",
    "Page titles are level-1 headings; heading levels are not skipped.",
    "Tables are labelled (aria-label from the caption) and show an empty state."
  ]
}
